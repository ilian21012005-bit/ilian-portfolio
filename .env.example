## URL du site (SEO: canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

## Données de contact (publiques)
NEXT_PUBLIC_CONTACT_NAME="Prénom Nom"
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_CONTACT_PHONE="+33 6 00 00 00 00"
NEXT_PUBLIC_CONTACT_LOCATION="Ville, France"
NEXT_PUBLIC_CONTACT_LINKEDIN_URL=https://www.linkedin.com/in/example
NEXT_PUBLIC_CONTACT_GITHUB_URL=https://github.com/example
NEXT_PUBLIC_CONTACT_CV_URL=/cv-fr.pdf
NEXT_PUBLIC_CONTACT_CV_URL_EN=/cv-en.pdf

## Optionnel : Formspree (https://formspree.io). Sans ça, le formulaire envoie via FormSubmit vers NEXT_PUBLIC_CONTACT_EMAIL.
# FORMSPREE_ID=xxxxxx

## Optionnel : URL de la v1
# NEXT_PUBLIC_V1_URL=https://v1.example.com
